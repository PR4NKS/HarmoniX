# =========================================================
# HarmoniX Discord Music Bot - Environment Configuration Template
# Copy this file to .env and replace placeholders with your credentials.
# =========================================================

# 1. Discord Bot Token (Required)
# Retrieve from: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# 2. Bot Identity & Defaults
DEFAULT_PREFIX=!
BOT_NAME=HarmoniX
BOT_ACTIVITY=🎵 /play | High-Fidelity Audio

# 3. Lavalink Audio Server Connection
# Default is localhost:2333 with password 'youshallnotpass'
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass

# 4. Optional Integrations
# Spotify: Enables resolving Spotify track/album/playlist URLs
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Genius: Fallback lyrics engine
GENIUS_API_TOKEN=your_genius_token

# 5. Playback & Queue Defaults
DEFAULT_VOLUME=80
MAX_QUEUE_SIZE=500
AUTO_LEAVE_SECONDS=180
DEFAULT_SEARCH_SOURCE=scsearch
LOG_LEVEL=INFO
